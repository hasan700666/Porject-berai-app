{
  "expo": {
    "name": "BERAI",
    "slug": "vaseting_app_2",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "berai",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/search.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.hasan700666.vaseting_app_2"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo-01.jpg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash_screen.jpg",
          "resizeMode": "cover",
          "backgroundColor": "#ffffff",
          "imageWidth": 200
        }
      ],
      "@react-native-vector-icons/ionicons",
      "expo-web-browser",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a317f86e-3add-4f82-bb5a-185857649e91"
      }
    }
  }
}
